# ============================================================
# Milenew Backend - variables de entorno (plantilla)
# Copia este archivo a ".env" y ajusta los valores.
# El archivo .env real NO se sube al repositorio.
# ============================================================

# --- Aplicacion ---
SECRET_KEY=cambia_esta_clave_en_produccion
DEBUG=True
PORT=5000

# --- Base de datos PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=milenew_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
